<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android36.1</TargetFramework>
    <RootNamespace>InpaDroid</RootNamespace>
    <AssemblyName>InpaDroid</AssemblyName>
    <ApplicationId>com.inpadroid.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="InTheHand.AndroidActivity" Version="1.0.5" />
    <PackageReference Include="InTheHand.Net.Bluetooth" Version="4.2.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Catálogos de chasis: un <id>_catalog.json por chasis, leídos por ChassisCatalog. -->
    <EmbeddedResource Include="Ui\Chassis\*_catalog.json" LogicalName="chassis.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../external/ediabaslib/EdiabasLib/EdiabasLib/EdiabasLib.csproj" />
    <ProjectReference Include="../../external/ediabaslib/EdiabasLib/AndroidNetBindings/UsbSerialNetBinding/UsbSerialNetBinding.csproj" />
  </ItemGroup>

</Project>
