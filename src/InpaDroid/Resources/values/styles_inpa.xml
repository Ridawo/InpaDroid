<?xml version="1.0" encoding="utf-8"?>
<!-- Colores y estilos de la interfaz estilo INPA. Dueño: agente UI. -->
<resources>
    <color name="inpa_blue">@color/m_primary</color>
    <color name="inpa_blue_dark">@color/m_primary_dark</color>
    <color name="inpa_bg">@color/m_bg</color>
    <color name="inpa_panel">@color/m_surface</color>
    <color name="inpa_status_bg">@color/m_primary_container</color>
    <color name="inpa_keybar_bg">@color/m_bg</color>
    <color name="inpa_text">@color/m_text</color>
    <color name="inpa_text_dim">@color/m_text_secondary</color>
    <color name="inpa_busy_bg">#FFF4C2</color>

    <style name="InpaTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/inpa_bg</item>
        <item name="android:colorPrimary">@color/inpa_blue</item>
        <item name="android:colorPrimaryDark">@color/inpa_blue_dark</item>
        <item name="android:colorAccent">@color/inpa_blue</item>
        <item name="android:statusBarColor">@color/inpa_blue_dark</item>
        <item name="android:textColor">@color/inpa_text</item>
    </style>

    <style name="InpaTitle">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="InpaMono">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/inpa_text</item>
    </style>

    <style name="InpaHeading">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/inpa_blue_dark</item>
    </style>

    <style name="InpaLabel">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/inpa_text</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="InpaLed">
        <item name="android:layout_width">14dp</item>
        <item name="android:layout_height">14dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_led</item>
    </style>
</resources>
