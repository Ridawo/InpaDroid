<?xml version="1.0" encoding="utf-8"?>
<!-- Centralita: resultados (Ident, errores, Steuern) o tabla de Status refrescada cada ~1 s. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m_bg"
    android:orientation="vertical">

    <include layout="@layout/inpa_header" />

    <TextView
        android:id="@+id/chassis_heading"
        style="@style/MText_Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:id="@+id/chassis_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/chassis_status"
                style="@style/MText_Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.35"
                android:padding="16dp"
                android:textIsSelectable="true"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/inpa_busy" />

    <include layout="@layout/inpa_fkeys" />
</LinearLayout>
