<?xml version="1.0" encoding="utf-8"?>
<!-- Escaneo rápido del chasis: resumen de la memoria de errores de todas las centralitas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m_bg"
    android:orientation="vertical">

    <include layout="@layout/inpa_header" />

    <TextView
        android:id="@+id/chassis_scan_heading"
        style="@style/MText_Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <ListView
        android:id="@+id/chassis_scan_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/m_bg"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />

    <include layout="@layout/inpa_busy" />

    <include layout="@layout/inpa_fkeys" />
</LinearLayout>
