<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m_bg"
    android:orientation="vertical">

    <include layout="@layout/inpa_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Tipo de conexion. Las notas/avisos y el panel USB se insertan tras el RadioGroup por codigo. -->
            <LinearLayout
                android:id="@+id/set_card_adapter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/MText_Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/set_sec_connection" />

                <RadioGroup
                    android:id="@+id/set_adapter_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/set_adapter_usb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:minHeight="56dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/set_adapter_usb"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/set_adapter_enet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:minHeight="56dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/set_adapter_enet"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/set_adapter_elmbt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:minHeight="56dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/set_adapter_elmbt"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/set_adapter_elmwifi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/set_adapter_elmwifi"
                        android:textSize="16sp" />
                </RadioGroup>
            </LinearLayout>

            <!-- Detalles segun el tipo elegido. -->
            <LinearLayout
                android:id="@+id/set_bt_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/MText_Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_bt_device" />

                <TextView
                    android:id="@+id/set_bt_selected"
                    style="@style/MText_Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/set_bt_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="@string/set_bt_search"
                    android:textAllCaps="false" />

                <LinearLayout
                    android:id="@+id/set_bt_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/set_enet_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/MText_Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_enet_host" />

                <EditText
                    android:id="@+id/set_enet_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ.-"
                    android:hint="auto"
                    android:imeOptions="actionDone"
                    android:inputType="textUri|textNoSuggestions"
                    android:minHeight="48dp"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/set_enet_error"
                    style="@style/MText_Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/m_error"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/set_wifi_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/MText_Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_wifi_host" />

                <EditText
                    android:id="@+id/set_wifi_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ.-:"
                    android:hint="192.168.0.10:35000"
                    android:imeOptions="actionDone"
                    android:inputType="textUri|textNoSuggestions"
                    android:minHeight="48dp"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/set_wifi_error"
                    style="@style/MText_Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/m_error"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/MText_Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_sec_ecu" />

                <EditText
                    android:id="@+id/set_ecu_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:imeOptions="actionDone"
                    android:inputType="textUri|textNoSuggestions"
                    android:minHeight="48dp"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/set_ecu_pick"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="@string/set_ecu_pick"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/set_ecu_default"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="@string/set_ecu_default"
                        android:textAllCaps="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/set_ecu_info"
                    style="@style/MText_Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/set_status"
                style="@style/MText_Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </ScrollView>

    <!-- Boton fijo abajo. -->
    <Button
        android:id="@+id/set_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_card_primary"
        android:minHeight="56dp"
        android:text="@string/set_save"
        android:textAllCaps="false"
        android:textColor="@color/m_on_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <include layout="@layout/inpa_fkeys" />
</LinearLayout>
