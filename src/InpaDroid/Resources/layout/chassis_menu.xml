<?xml version="1.0" encoding="utf-8"?>
<!-- Menú BMW del chasis: lista de centralitas del catálogo (como la selección de SG de INPA). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/inpa_bg"
    android:orientation="vertical">

    <include layout="@layout/inpa_header" />

    <TextView
        android:id="@+id/chassis_menu_heading"
        style="@style/InpaHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="Selección de centralita" />

    <ListView
        android:id="@+id/chassis_menu_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/inpa_panel"
        android:divider="#B0B0B0"
        android:dividerHeight="1dp" />

    <include layout="@layout/inpa_fkeys" />
</LinearLayout>
