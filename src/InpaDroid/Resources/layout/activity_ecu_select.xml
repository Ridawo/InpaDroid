<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m_bg"
    android:orientation="vertical">

    <include layout="@layout/inpa_header" />

    <EditText
        android:id="@+id/ecu_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:minHeight="48dp"
        android:fontFamily="monospace"
        android:hint="@string/ecu_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="textCapCharacters|textNoSuggestions"
        android:singleLine="true" />

    <TextView
        android:id="@+id/ecu_count"
        style="@style/MText_Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

    <ListView
        android:id="@+id/ecu_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/m_bg"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:fastScrollEnabled="true"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />

    <include layout="@layout/inpa_fkeys" />
</LinearLayout>
