    "actions": [
      {
        "title": "Electroventilador al 50 %",
        "job": "STEUERN_E_LUEFTER",
        "args": "50",
        "warning": "El ventilador eléctrico del radiador girará a media potencia. Mantén manos, ropa y cables lejos. Prueba de actuador. Coche parado, freno de mano puesto, cambio en P/punto muerto y contacto puesto (motor apagado salvo que se indique). Aléjate de correas y ventilador. Al acabar pulsa \"Terminar activaciones\" o quita el contacto para devolver el control a la centralita."
      },
      {
        "title": "Relé de precalentamiento (calentadores)",
        "job": "STEUERN_GLUEHRELAIS",
        "args": "100",
        "warning": "Activa los calentadores. Úsalo solo unos segundos y no lo repitas seguido: se calientan mucho. Prueba de actuador. Coche parado, freno de mano puesto, cambio en P/punto muerto y contacto puesto (motor apagado salvo que se indique). Aléjate de correas y ventilador. Al acabar pulsa \"Terminar activaciones\" o quita el contacto para devolver el control a la centralita."
      },
      {
        "title": "Válvula EGR (AGR) al 95 %",
        "job": "STEUERN_AGR_STELLER",
        "args": "95",
        "warning": "Mueve la válvula de recirculación de gases; necesita vacío (motor al ralentí para oírla). Prueba de actuador. Coche parado, freno de mano puesto, cambio en P/punto muerto y contacto puesto (motor apagado salvo que se indique). Aléjate de correas y ventilador. Al acabar pulsa \"Terminar activaciones\" o quita el contacto para devolver el control a la centralita."
      },
      {
        "title": "Actuador presión de turbo al 95 %",
        "job": "STEUERN_LADEDRUCKSTELLER",
        "args": "95",
        "warning": "Mueve la electroválvula de presión de turbo; necesita vacío (motor al ralentí). No aceleres durante la prueba. Prueba de actuador. Coche parado, freno de mano puesto, cambio en P/punto muerto y contacto puesto (motor apagado salvo que se indique). Aléjate de correas y ventilador. Al acabar pulsa \"Terminar activaciones\" o quita el contacto para devolver el control a la centralita."
      },
      {
        "title": "Terminar activaciones",
        "job": "DIAGNOSE_ENDE",
        "args": "",
        "warning": "Cierra la sesión de diagnosis de la DDE y devuelve el control de todos los actuadores a la centralita."
      }
