<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Pure-logic sources linked from the Android app (no Android/EdiabasLib dependencies). -->
  <ItemGroup>
    <Compile Include="..\..\src\InpaDroid\Diag\DiagModels.cs" Link="Linked\DiagModels.cs" />
    <Compile Include="..\..\src\InpaDroid\Diag\DiagLogic.cs" Link="Linked\DiagLogic.cs" />
    <Compile Include="..\..\src\InpaDroid\Diag\JobPolicy.cs" Link="Linked\JobPolicy.cs" />
    <Compile Include="..\..\src\InpaDroid\Diag\BatteryGuard.cs" Link="Linked\BatteryGuard.cs" />
    <Compile Include="..\..\src\InpaDroid\Diag\FaultInfo.cs" Link="Linked\FaultInfo.cs" />
    <Compile Include="..\..\src\InpaDroid\Diag\SetupCheck.cs" Link="Linked\SetupCheck.cs" />
    <Compile Include="..\..\src\InpaDroid\Diag\ReportBuilder.cs" Link="Linked\ReportBuilder.cs" />
    <Compile Include="..\..\src\InpaDroid\Diag\SessionRecord.cs" Link="Linked\SessionRecord.cs" />
    <Compile Include="..\..\src\InpaDroid\Diag\EcuImport.cs" Link="Linked\EcuImport.cs" />
    <Compile Include="..\..\src\InpaDroid\Diag\LiveLog.cs" Link="Linked\LiveLog.cs" />
    <Compile Include="..\..\src\InpaDroid\Diag\CodingBackup.cs" Link="Linked\CodingBackup.cs" />
    <Compile Include="..\..\src\InpaDroid\Diag\InactivityWatchdog.cs" Link="Linked\InactivityWatchdog.cs" />
    <Compile Include="..\..\src\InpaDroid\Ui\Live\LiveSeriesData.cs" Link="Linked\LiveSeriesData.cs" />
    <Compile Include="..\..\src\InpaDroid\Ui\Chassis\ChassisModel.cs" Link="Linked\ChassisModel.cs" />
    <Compile Include="..\..\src\InpaDroid\Ui\Chassis\ScanSummary.cs" Link="Linked\ScanSummary.cs" />
    <Compile Include="..\..\src\InpaDroid\Ui\Chassis\ChassisCatalog.cs" Link="Linked\ChassisCatalog.cs" />
    <EmbeddedResource Include="..\..\src\InpaDroid\Ui\Chassis\*_catalog.json" LogicalName="chassis.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\src\InpaDroid\Ui\Chassis\*_catalog.en.json" WithCulture="false" LogicalName="chassis.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
