<Project Sdk="Microsoft.NET.Sdk">
  <!-- Herramienta de escritorio (Linux/Windows): vuelca jobs/argumentos/resultados/tablas de .prg/.grp
       usando los jobs offline de EdiabasLib. Compila el código fuente de EdiabasLib directamente
       (su csproj solo apunta a windows/net481/android) sin modificar nada bajo external/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0219;CS0414;CS0649;CS0169;CS8632;CA1416;SYSLIB0014;CS0618</NoWarn>
    <EdiabasLibDir>$(MSBuildThisFileDirectory)../../external/ediabaslib/EdiabasLib/EdiabasLib/</EdiabasLibDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(EdiabasLibDir)*.cs"
             Exclude="$(EdiabasLibDir)*Android.cs;$(EdiabasLibDir)BtLeGattSpp.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="InTheHand.Net.Bluetooth" Version="4.2.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
  </ItemGroup>
</Project>
